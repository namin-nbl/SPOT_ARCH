# Copy these values into local environment variables or Vercel Project Settings.
# Orbit creates/uses a 64-character hexadecimal secret for webhook signing.
ORBIT_WEBHOOK_SECRET=replace_with_64_hex_characters

# Map Orbit robot hostnames/nicknames to approved ARCH plant IDs.
ORBIT_ROBOT_PLANT_MAP={"spot-blm-01":"BLM","spot-jax-01":"JAX"}

# Optional fallback when every robot handled by this deployment belongs to one plant.
# ORBIT_DEFAULT_PLANT_ID=BLM

# Optional durable event archive. Strongly recommended on Vercel.
# ORBIT_EVENT_SINK_URL=https://integration.example.com/orbit/events
# ORBIT_EVENT_SINK_TOKEN=replace_with_sink_bearer_token
# ORBIT_EVENT_SINK_TIMEOUT_MS=5000

# Protects GET /api/webhooks/orbit/events.
ORBIT_ADMIN_TOKEN=replace_with_a_long_random_value

# Development only. Never enable this on a production deployment.
# ORBIT_ALLOW_UNSIGNED_WEBHOOKS=true
# ORBIT_ALLOW_HTTP_SINK=true
